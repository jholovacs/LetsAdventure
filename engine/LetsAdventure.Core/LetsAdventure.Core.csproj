<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LetsAdventure.Core</RootNamespace>
    <AssemblyName>LetsAdventure.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <EmbeddedResource Include="World\Gpu\Shaders\river_channel_carve.comp">
      <LogicalName>LetsAdventure.Core.river_channel_carve.comp</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="World\Gpu\Shaders\river_water_surface.comp">
      <LogicalName>LetsAdventure.Core.river_water_surface.comp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
