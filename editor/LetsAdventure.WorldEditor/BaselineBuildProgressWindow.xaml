<Window x:Class="LetsAdventure.WorldEditor.BaselineBuildProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building baseline world"
        Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Theme.Window.Background}"
        Foreground="{DynamicResource Theme.Window.Foreground}">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="TxtStatus" Margin="0,0,0,6" TextWrapping="Wrap"
                 Text="Building baseline — please wait…" />
      <ProgressBar x:Name="PrgBusy" Height="12" IsIndeterminate="True" Minimum="0" Maximum="100" Value="0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button x:Name="BtnCancel" Content="Cancel build" Width="120" Margin="0,0,8,0" Click="BtnCancel_OnClick" />
        <Button x:Name="BtnClose" Content="Close" Width="100" IsEnabled="False" Click="BtnClose_OnClick" />
      </StackPanel>
    </StackPanel>
    <TextBox x:Name="TxtLog"
             IsReadOnly="True"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             TextWrapping="Wrap"
             FontFamily="Consolas"
             FontSize="12"
             Background="{DynamicResource Theme.Log.Background}"
             Foreground="{DynamicResource Theme.Log.Foreground}" />
  </DockPanel>
</Window>
