<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- HelixToolkit targets netframework in its nuspec; package works on net9-windows. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>LetsAdventure World Editor</ApplicationTitle>
    <AssemblyName>LetsAdventure.WorldEditor</AssemblyName>
    <RootNamespace>LetsAdventure.WorldEditor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\engine\LetsAdventure.Core\LetsAdventure.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="2.27.3" />
  </ItemGroup>
</Project>
